DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_APP_URL=
# 2GIS Raster Tiles API кілті (platform.2gis.ru). Бос болса, карта OpenStreetMap-ті көрсетеді.
NEXT_PUBLIC_2GIS_KEY=

# prisma/seed.ts сынақ аккаунттарына қоятын құпиясөз (a12_kitchen, ses1, admin т.б.). Репозиторийге жазбаңыз.
SEED_PASSWORD=""

# Порция фотосын ИИ тексеруі: OpenAI-үйлесімді API (Chat Completions + сурет).
# Google Gemini: тегін кілт — https://aistudio.google.com/apikey
# Бос қалса, ИИ өшірулі: тек қайталанған фото тексеріледі.
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL="gemini-flash-latest,gemini-3.8-flash,gemini-flash-lite-latest"
AI_API_KEY=""

# Камерадан түсіру: асхана нысанынан осы радиуста (м) ғана түсіруге болады.
GEOFENCE_M="150"
# Оқу-жаттығу нысандарында (А-12, К-14) геолокация мен QR-тұғыр міндетті емес ("false" — міндетті).
TRAINING_GEOFENCE_BYPASS="true"

# Термометр-щуп №AD асханасының тұрақты кілті: seed оны құрылғы ретінде тіркейді, құрылғының бағдарламасына да сол жазылады.
# Жасау: node -e "console.log('adk_'+require('crypto').randomBytes(24).toString('base64url'))"
DEMO_DEVICE_KEY=""
