generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  KITCHEN
  NURSE
  SES
  EDU
  ADMIN
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum LogType {
  PHOTO
  FRIDGE_TEMP
  HOT_TEMP
  WASTE // қайтарылған табақтар фотосы: ИИ жеу индексін бағалайды
}

// Журнал жазбасын кім енгізді: қызметкер қолмен не құрылғы (термометр, датчик).
enum LogSource {
  MANUAL
  DEVICE
}

// Тағам санаты: беру температурасының нормасы соған байланысты (сорпа ≥75°C, екінші тағам ≥65°C).
enum DishCategory {
  SOUP
  MAIN
  HOT_DRINK
  COLD
}

// Асхана құрылғысы: тағам термометрі (щуп) не тоңазытқыш датчигі.
enum DeviceKind {
  PROBE
  FRIDGE
}

enum Symptom {
  NAUSEA
  VOMITING
  DIARRHEA
  FEVER
  ABDOMINAL_PAIN
  OTHER
}

enum InspectionType {
  MONITORING
  UNANNOUNCED
  UNSCHEDULED
}

enum PrescriptionStatus {
  OPEN
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum FacilityKind {
  SCHOOL
  KINDERGARTEN
  RESTAURANT
  CAFE
  CANTEEN
}

// Порция фотосын ИИ тексеруі: инспектор тек FLAGGED фотоларды қарайды.
enum PhotoCheck {
  PENDING
  OK
  FLAGGED
  ERROR
  DISABLED
}

model District {
  id      String   @id @default(cuid())
  name    String
  schools School[]
}

// Тарихи себеппен "School" деп аталады, бірақ кез келген тамақтану нысанын білдіреді:
// мектеп, балабақша, мейрамхана, кафе немесе қоғамдық асхана (kind өрісі).
model School {
  id               String       @id @default(cuid())
  code             String?      @unique // мыс. "А-12", "М-07": интерфейсте атаудың орнына көрсетіледі
  kind             FacilityKind @default(SCHOOL)
  dgisId           String?      @unique
  rubric           String?
  name             String
  address          String
  lat              Float
  lng              Float
  studentsCount    Int
  districtId       String
  district         District     @relation(fields: [districtId], references: [id])
  riskScore        Int          @default(0)
  riskLevel        RiskLevel    @default(GREEN)
  lastInspectionAt DateTime?
  parentToken      String       @unique @default(cuid())
  isTraining       Boolean      @default(false)

  users          User[]
  menuItems      MenuItem[]
  kitchenLogs    KitchenLog[]
  symptomReports SymptomReport[]
  feedback       ParentFeedback[]
  deliveries     Delivery[]
  riskSnapshots  RiskSnapshot[]
  alerts         Alert[]
  inspections    Inspection[]
  prescriptions  Prescription[]
  devices        Device[]
  staff          Staff[]
}

model User {
  id           String  @id @default(cuid())
  login        String  @unique
  passwordHash String
  name         String
  role         Role
  schoolId     String?
  school       School? @relation(fields: [schoolId], references: [id])
}

model Supplier {
  id                    String   @id @default(cuid())
  name                  String
  bin                   String
  certificateValidUntil DateTime
  blocked               Boolean  @default(false)
  batches               Batch[]
}

model Batch {
  id         String     @id @default(cuid())
  code       String     @unique
  product    String
  producedAt DateTime
  expiresAt  DateTime
  supplierId String
  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  deliveries Delivery[]
  menuItems  MenuItem[]
}

model Delivery {
  id          String   @id @default(cuid())
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  deliveredAt DateTime
}

model MenuItem {
  id               String        @id @default(cuid())
  schoolId         String
  school           School        @relation(fields: [schoolId], references: [id])
  date             DateTime      @db.Date
  name             String
  standardPortionG Int?
  batchId          String?
  batch            Batch?        @relation(fields: [batchId], references: [id])
  blocked          Boolean       @default(false)
  category         DishCategory  @default(MAIN)
  // СЭС бекіткен жоспардағы тағам; жоқ болса — жоспардан тыс (себебі offPlanReason-да, СЭС-ке сары алерт).
  planItemId       String?
  planItem         MenuPlanItem? @relation(fields: [planItemId], references: [id])
  offPlanReason    String?

  logs KitchenLog[]
}

model KitchenLog {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  menuItemId  String?
  menuItem    MenuItem? @relation(fields: [menuItemId], references: [id])
  type        LogType
  valueC      Float?
  photoUrl    String?
  isViolation Boolean   @default(false)
  createdAt   DateTime  @default(now())
  createdById String

  // Тек PHOTO жазбалары үшін: sha256 (қайталанған фотоны табу) және ИИ тексеруінің нәтижесі.
  photoHash    String?
  aiStatus     PhotoCheck?
  aiIssues     String[]    @default([])
  aiPortionPct Int?
  aiSummary    String?
  aiModel      String?
  aiCheckedAt  DateTime?
  reviewedAt   DateTime?
  // Тек WASTE үшін: табақтарда қалған тағамның үлесі (%), жеу индексі = 100 − осы.
  aiWastePct   Int?
  source       LogSource   @default(MANUAL)
  deviceId     String?

  @@index([type, createdAt])
  @@index([photoHash])
}

model SymptomReport {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  grade       String
  symptoms    Symptom[]
  reportedAt  DateTime  @default(now())
  createdById String
}

model ParentFeedback {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model RiskSnapshot {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  score      Int
  level      RiskLevel
  components Json
  computedAt DateTime  @default(now())
}

model Alert {
  id             String      @id @default(cuid())
  schoolId       String
  school         School      @relation(fields: [schoolId], references: [id])
  level          RiskLevel
  reason         String
  details        Json
  relatedBatchId String?
  status         AlertStatus @default(OPEN)
  // Автоматты ереже (FRIDGE, OFF_PLAN, INGREDIENT, EATABILITY): ашық тұрғанда нысан кемінде сары.
  rule           String?
  createdAt      DateTime    @default(now())
  acknowledgedAt DateTime?
  closedAt       DateTime?
  closingNote    String?

  prescriptions Prescription[]
}

model Inspection {
  id          String         @id @default(cuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id])
  inspectorId String
  type        InspectionType
  plannedAt   DateTime
  doneAt      DateTime?
  result      String?
}

model Prescription {
  id               String             @id @default(cuid())
  schoolId         String
  school           School             @relation(fields: [schoolId], references: [id])
  alertId          String?
  alert            Alert?             @relation(fields: [alertId], references: [id])
  text             String
  dueAt            DateTime
  status           PrescriptionStatus @default(OPEN)
  evidencePhotoUrl String?
  submittedAt      DateTime?
  decidedAt        DateTime?
}

// Камерадан түсіруге арналған бір реттік токен: сервер 2 минутқа береді, фото жүктелгенде өшеді.
// Геолокация токен берілгенде тексеріледі; нысан коды мен сервер уақыты су белгісіне жазылады.
model CaptureToken {
  id        String    @id // кездейсоқ 24 байт, base64url
  schoolId  String
  purpose   String // PORTION | PROOF
  targetId  String // мәзірдегі тағам не нұсқама
  distanceM Int?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([schoolId, createdAt])
}

// Асхана құрылғысы (мысалы, ESP32 + DS18B20 щуп). Кілттің өзі сақталмайды, тек sha256 хэші:
// құрылғы POST /api/device/readings сұранысына "Authorization: Bearer <кілт>" қосады.
model Device {
  id          String     @id @default(cuid())
  schoolId    String
  school      School     @relation(fields: [schoolId], references: [id])
  kind        DeviceKind
  label       String
  keyHash     String     @unique
  keyHint     String // кілттің соңғы 4 таңбасы: тізімде қай құрылғы екенін тану үшін
  createdAt   DateTime   @default(now())
  lastSeenAt  DateTime?
  lastValue   Float?
  revokedAt   DateTime?
  // PROBE: қызметкер «Өлшеу» басқан мәзірдегі тағам. Осыдан кейін 2 минут ішінде келген өлшем соған жазылады.
  armedTarget String?
  armedAt     DateTime?

  readings DeviceReading[]

  @@index([schoolId])
}

model DeviceReading {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  schoolId  String
  value     Float
  target    String? // қай журнал жазбасына (KitchenLog) жазылды
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

// Асхана қызметкері: аты-жөні сақталмайды, тек лауазымы мен бас әріптері ("Аспаз · Г. С.").
model Staff {
  id       String       @id @default(cuid())
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id])
  label    String
  active   Boolean      @default(true)
  checks   StaffCheck[]
}

// Смена алдындағы тексеру: ИИ фотодан форманы бағалайды (бас киім/тор, қолғап, таза алжапқыш).
// Қызметкердің фотосы сақталмайды — тек нәтиже мен хэш (қайталанған фотоны табу үшін).
model StaffCheck {
  id          String     @id @default(cuid())
  staffId     String
  staff       Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  schoolId    String
  createdAt   DateTime   @default(now())
  photoHash   String?
  aiStatus    PhotoCheck @default(PENDING)
  aiIssues    String[]   @default([])
  aiSummary   String?
  aiModel     String?
  aiCheckedAt DateTime?

  @@index([schoolId, createdAt])
}

// СЭС бекіткен екі апталық циклдік мәзір (мектеп, балабақша): оқу күні (1–10) бойынша тағамдар мен техкарта.
model MenuPlanItem {
  id             String       @id @default(cuid())
  kind           FacilityKind
  day            Int
  name           String
  category       DishCategory
  portionG       Int
  mainIngredient String // техкартадағы негізгі өнім: партиядағы өніммен салыстырылады
  composition    String
  approvedAt     DateTime
  menuItems      MenuItem[]

  @@index([kind, day])
}
